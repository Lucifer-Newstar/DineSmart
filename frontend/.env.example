# Copy to .env.local. Production values are listed in Docs/Developers Guide/Deployment.md.
# Browser requests stay same-origin; Next.js proxies API calls server-side.
# Production (Vercel): the Render API URL, e.g. https://your-api.onrender.com. Read at build time.
API_PROXY_TARGET=http://127.0.0.1:3001
# Public Google OAuth client ID for Google Identity Services; not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public origin of the API for the realtime WebSocket, e.g. https://your-api.onrender.com.
# The socket connects there directly (rewrites cannot proxy WebSockets); the backend checks
# that the page's origin equals WEB_ORIGIN. Leave empty on localhost (port 3001 is assumed);
# without it in production, notifications fall back to polling every minute.
NEXT_PUBLIC_REALTIME_URL=
# Public sample restaurant ObjectId used by the /book flow; replace for a different demo.
NEXT_PUBLIC_DEMO_RESTAURANT_ID=710000000000000000000001
