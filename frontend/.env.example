# Copy to .env.local. Browser requests stay same-origin; Next.js proxies API calls server-side.
API_PROXY_TARGET=http://127.0.0.1:3001
# Public Google OAuth client ID for Google Identity Services; not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public sample restaurant ObjectId used by the /book flow; replace for a different demo.
NEXT_PUBLIC_DEMO_RESTAURANT_ID=710000000000000000000001
