{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/database/seed.cli.ts",
    "bootstrap": "tsx src/database/bootstrap.cli.ts",
    "demo:fixtures": "tsx src/database/demo-fixtures.cli.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "argon2": "0.45.2",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "google-auth-library": "11.3.3",
    "jose": "6.2.15",
    "mongodb": "7.8.0",
    "nodemailer": "10.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.21.0"
  }
}
