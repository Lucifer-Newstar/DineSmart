# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/andhrimnir

# Authentication configuration. Generate JWT_SECRET with a CSPRNG (e.g. openssl rand -base64 32).
JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use the approved local/mock adapter until an email provider is selected.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# Gemini is server-side. Leave blank until provider setup and model selection.
GEMINI_API_KEY=
GEMINI_MODEL=
