# Copy to .env for local development. Never commit real credentials.
# Production values (Render) are listed in Docs/Developers Guide/Deployment.md.
NODE_ENV=development
PORT=3001
# Production: mongodb+srv://<user>:<password>@<cluster-host>/andhrimnir (Atlas, own DB user).
MONGODB_URI=mongodb://127.0.0.1:27017/andhrimnir
# Demo seed (npm run seed): runs only with NODE_ENV=development. A non-local host (e.g. Atlas)
# also needs --allow-remote (or SEED_ALLOW_REMOTE=1) and --confirm <database> (or SEED_CONFIRM_DATABASE).
SEED_DEMO_PASSWORD=Andhrimnir-Demo-Only-Change-Me
SEED_ALLOW_REMOTE=
SEED_CONFIRM_DATABASE=
# First restaurant + administrator (npm run bootstrap -- --help). Set only while running it;
# 12+ characters, never passed on the command line.
BOOTSTRAP_PASSWORD=

# Authentication. JWT_SECRET needs at least 32 random bytes: openssl rand -base64 48
JWT_SECRET=

# Signs the table QR links (S5-03). Optional: when empty a key is derived from
# JWT_SECRET. Change it to invalidate every printed table card at once.
TABLE_QR_SECRET=
# Exact public frontend origin (CORS + WebSocket check), no trailing slash; required in production.
WEB_ORIGIN=http://localhost:3000
# Proxy hops in front of the API, used for per-IP rate limits. Unset means 1 in
# production and off in development. Behind the Vercel rewrite to Render this is
# probably 2 (Vercel + Render's load balancer), but it has not been verified live:
# check req.ip after deploying. Never use "true".
TRUST_PROXY=
# Google Identity Services ID-token verification uses the public OAuth client ID; no client secret is needed.
GOOGLE_CLIENT_ID=

# Email for sign-up codes and password resets: mock | smtp | resend.
# mock sends nothing and is refused in production; the server will not start
# in production unless smtp or resend is configured.
EMAIL_PROVIDER=mock
# Sender shown to users, e.g. "DineSmart <no-reply@your-domain.com>" (smtp and resend).
EMAIL_FROM=
# smtp: any SMTP server (Gmail app password, Brevo, Mailgun, SES SMTP, ...).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false uses STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# resend: API key from resend.com (EMAIL_API_KEY is accepted as a fallback name).
RESEND_API_KEY=

# Gemini API key stays server-side; without it, deterministic recommendations remain available.
GEMINI_API_KEY=
# Default model: a stable, low-cost choice; change it per project.
GEMINI_MODEL=gemini-3.5-flash-lite
